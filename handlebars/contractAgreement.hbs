<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contrato Concretado - RentUp</title>
    <style>
        body { margin: 0; padding: 0; background-color: #f7f9fb; font-family: Inter, Arial, sans-serif; }
        table { border-spacing: 0; }
        @media only screen and (max-width: 620px) {
            .container { width: 100% !important; max-width: 100% !important; }
            .content { padding: 20px 16px !important; }
            .responsive-grid { width: 100% !important; display: block !important; }
            .responsive-grid td { display: block !important; width: 100% !important; text-align: center !important; padding: 8px 0 !important; }
            .responsive-grid .right-cell { text-align: center !important; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f7f9fb;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f7f9fb">
        <tr>
            <td align="center" style="padding: 40px 16px;">
                <table width="600" cellpadding="0" cellspacing="0" border="0" class="container" style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 3px rgba(14,26,43,0.04), 0 8px 24px -12px rgba(14,26,43,0.12);">

                    <!-- HEADER -->
                    <tr>
                        <td bgcolor="#2E5A88" style="padding: 24px 32px; text-align: center;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="font-family: Manrope, Arial, sans-serif; font-size: 22px; font-weight: 800; color: #ffffff; letter-spacing: -0.3px; padding-bottom: 4px;">
                                        <img src="data:image/png;base64,
                                        " alt="RentUp" width="32" height="32" style="display: inline-block; vertical-align: middle; margin-right: 8px;">
                                        <span style="vertical-align: middle;">RentUp</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="font-family: Manrope, Arial, sans-serif; font-size: 12px; font-weight: 500; color: #B3C8E0; letter-spacing: 2px; text-transform: uppercase; padding-top: 4px;">
                                        Contrato de Arrendamiento
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- HERO -->
                    <tr>
                        <td style="padding: 48px 32px 32px; text-align: center; background: linear-gradient(180deg, #f2f6fa 0%, #ffffff 100%);">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="padding-bottom: 20px;">
                                        <table cellpadding="0" cellspacing="0" border="0" style="width: 80px; height: 80px; border-radius: 50%; background-color: #ffffff; box-shadow: 0 4px 16px rgba(46,90,136,0.10);">
                                            <tr>
                                                <td align="center" style="font-size: 36px; line-height: 80px;">🤝</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="font-family: Manrope, Arial, sans-serif; font-size: 30px; font-weight: 800; color: #2E5A88; letter-spacing: -0.5px; padding-bottom: 10px;">
                                        &iexcl;Contrato concretado!
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="font-family: Inter, Arial, sans-serif; font-size: 16px; color: #536379; line-height: 1.7; max-width: 440px; padding: 0 8px;">
                                        Felicidades <strong style="color: #1c2d44;">{{nombre}} {{apellido}}</strong>, has llegado a un acuerdo exitoso.
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- CONTRACT CARD -->
                    <tr>
                        <td style="padding: 8px 32px 24px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #F7F9FB; border: 1px solid #E5DFD2; border-radius: 16px;">
                                <tr>
                                    <td style="padding: 28px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="padding-bottom: 16px;">
                                                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                                        <tr>
                                                            <td style="font-family: 'Public Sans', Inter, Arial, sans-serif; font-size: 11px; font-weight: 700; color: #6b7280; letter-spacing: 2px; text-transform: uppercase;">
                                                                Resumen del Contrato
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 12px 0; border-bottom: 1px solid #E5DFD2;">
                                                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                                        <tr>
                                                            <td style="font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; width: 50%;">Vivienda</td>
                                                            <td style="font-family: Manrope, Arial, sans-serif; font-size: 15px; font-weight: 700; color: #1c2d44; text-align: right;">{{aptName}}</td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 12px 0; border-bottom: 1px solid #E5DFD2;">
                                                    <table width="100%" cellpadding="0" cellspacing="0" border="0" class="responsive-grid">
                                                        <tr>
                                                            <td style="font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; width: 50%;">
                                                                <div style="font-size: 11px; color: #9ca3af; margin-bottom: 2px;">Fecha de inicio</div>
                                                                <span style="font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 600; color: #1c2d44;">{{startDate}}</span>
                                                            </td>
                                                            <td style="font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; width: 50%; text-align: right;" class="right-cell">
                                                                <div style="font-size: 11px; color: #9ca3af; margin-bottom: 2px;">Fecha de fin</div>
                                                                <span style="font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 600; color: #1c2d44;">{{endDate}}</span>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 12px 0;">
                                                    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: rgba(46,90,136,0.04); border-radius: 8px;">
                                                        <tr>
                                                            <td style="padding: 16px 20px;">
                                                                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                                                    <tr>
                                                                        <td style="font-family: Manrope, Arial, sans-serif; font-size: 14px; font-weight: 700; color: #2E5A88;">Renta mensual</td>
                                                                        <td style="font-family: Manrope, Arial, sans-serif; font-size: 26px; font-weight: 800; color: #2E5A88; text-align: right;">${{rent}}</td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- CTA -->
                    <tr>
                        <td style="padding: 0 32px 24px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center">
                                        <table cellpadding="0" cellspacing="0" border="0" style="border-radius: 50px; background: linear-gradient(135deg, #3f2acc, #5849e4); box-shadow: 0 8px 24px rgba(63,42,204,0.25);">
                                            <tr>
                                                <td align="center" style="padding: 16px 48px;">
                                                    <a href="{{contratoUrl}}" style="font-family: Manrope, Arial, sans-serif; font-size: 15px; font-weight: 700; color: #ffffff; text-decoration: none; line-height: 1; letter-spacing: 0.3px;">Ver contrato completo</a>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- INFO NOTE -->
                    <tr>
                        <td style="padding: 0 32px 40px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.15); border-radius: 12px;">
                                <tr>
                                    <td style="padding: 16px 20px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td width="28" valign="top" style="font-size: 18px; line-height: 1; color: #F59E0B; padding-right: 12px;">&#x2139;</td>
                                                <td style="font-family: Inter, Arial, sans-serif; font-size: 13px; color: #6b7280; line-height: 1.7;">
                                                    Por favor, aseg&uacute;rate de cumplir con todas las condiciones acordadas. Si tienes preguntas sobre tu contrato, puedes contactarnos en cualquier momento.
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td style="padding: 0 32px 32px;">
                            {{> _footer}}
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
