<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recordatorio de Pago - RentUp</title>
    <style>
        body { margin: 0; padding: 0; background-color: #f7f9fb; font-family: Inter, Arial, sans-serif; }
        table { border-spacing: 0; }
        @media only screen and (max-width: 620px) {
            .container { width: 100% !important; max-width: 100% !important; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f7f9fb;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f7f9fb">
        <tr>
            <td align="center" style="padding: 40px 16px;">
                <table width="600" cellpadding="0" cellspacing="0" border="0" class="container" style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 3px rgba(14,26,43,0.04), 0 8px 24px -12px rgba(14,26,43,0.12);">

                    <!-- HEADER -->
                    <tr>
                        <td bgcolor="#F59E0B" style="padding: 20px 32px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="left" style="font-family: Manrope, Arial, sans-serif; font-size: 20px; font-weight: 800; color: #ffffff;">
                                        <img src="data:image/png;base64,"/>

                                        <span style="font-family: Manrope, Arial, sans-serif; font-size: 20px; font-weight: 800; color: #ffffff; vertical-align: middle; margin-left: 8px;">RentUp</span>
                                    </td>
                                    <td align="right" style="font-family: Inter, Arial, sans-serif; font-size: 12px; color: #FEF3C7;">
                                        <table cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="font-family: Inter, Arial, sans-serif; font-size: 12px; color: #FEF3C7; padding-right: 4px;">Recordatorio de Pago</td>
                                                <td style="font-size: 12px; line-height: 1; color: #FEF3C7;">ℹ</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- HERO -->
                    <tr>
                        <td style="padding: 40px 32px 24px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="padding-bottom: 16px;">
                                        <table cellpadding="0" cellspacing="0" border="0" style="width: 64px; height: 64px; border-radius: 50%; background-color: #FFFBEB;">
                                            <tr>
                                                <td align="center" style="font-size: 28px; line-height: 64px; color: #F59E0B;">🔔</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="font-family: Manrope, Arial, sans-serif; font-size: 26px; font-weight: 700; color: #F59E0B; padding-bottom: 12px;">
                                        Recordatorio de pago
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="font-family: Inter, Arial, sans-serif; font-size: 15px; color: #536379; line-height: 1.6;">
                                        Hola <strong style="color: #0e1a2b;">{{nombre}} {{apellido}}</strong>, tu pago de arriendo est&aacute; pr&oacute;ximo a vencer.
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- PAYMENT DETAILS CARD -->
                    <tr>
                        <td style="padding: 8px 32px 24px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #FFFBEB; border: 1px solid #FDE68A; border-radius: 12px;">
                                <tr>
                                    <td style="padding: 24px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; width: 40%;">Vivienda</td>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 600; color: #0e1a2b; text-align: right;">{{direccion}}{{#if barrio}} ({{barrio}}){{/if}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; border-top: 1px solid #FDE68A;">Monto</td>
                                                <td style="padding: 8px 0; font-family: Manrope, Arial, sans-serif; font-size: 16px; font-weight: 700; color: #0e1a2b; text-align: right; border-top: 1px solid #FDE68A;">${{formatCurrency amount}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; border-top: 1px solid #FDE68A;">Vence en</td>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 600; color: #EF4444; text-align: right; border-top: 1px solid #FDE68A;">{{#if (gt daysLeft 0)}}{{daysLeft}} d&iacute;as{{else}}Hoy{{/if}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; border-top: 1px solid #FDE68A;">Fecha l&iacute;mite</td>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 600; color: #0e1a2b; text-align: right; border-top: 1px solid #FDE68A;">{{formatDate dueDate}}</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- INFO TEXT -->
                    <tr>
                        <td style="padding: 0 32px 24px;">
                            <p style="margin: 0; font-family: Inter, Arial, sans-serif; font-size: 14px; color: #777587; line-height: 1.7; text-align: center;">
                                Realiza tu pago a tiempo para evitar cargos adicionales. Puedes pagar de forma segura desde tu panel de usuario en RentUp con cualquier medio de pago.
                            </p>
                        </td>
                    </tr>

                    <!-- CTA -->
                    <tr>
                        <td align="center" style="padding: 8px 32px 40px;">
                            <a href="{{frontendUrl}}/dashboard" style="display: inline-block; background: linear-gradient(135deg, #3f2acc, #5849e4); color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 999px; font-family: Manrope, Arial, sans-serif; font-size: 14px; font-weight: 600; box-shadow: 0 4px 12px rgba(63, 42, 204, 0.25);">Pagar ahora</a>
                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td style="padding: 0 32px 32px;">
                            {{> _footer}}
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>