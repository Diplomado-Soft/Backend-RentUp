<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pago Confirmado - RentUp</title>
    <style>
        body { margin: 0; padding: 0; background-color: #f7f9fb; font-family: Inter, Arial, sans-serif; }
        table { border-spacing: 0; }
        @media only screen and (max-width: 620px) {
            .container { width: 100% !important; max-width: 100% !important; }
            .content { padding: 20px 16px !important; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f7f9fb;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f7f9fb">
        <tr>
            <td align="center" style="padding: 40px 16px;">
                <table width="600" cellpadding="0" cellspacing="0" border="0" class="container" style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 3px rgba(14,26,43,0.04), 0 8px 24px -12px rgba(14,26,43,0.12);">

                    <!-- HEADER -->
                    <tr>
                        <td bgcolor="#10B981" style="padding: 20px 32px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="font-family: Manrope, Arial, sans-serif; font-size: 20px; font-weight: 700; color: #ffffff;"><img src="data:image/png;base64,...</td>
                                    <td align="right" style="font-family: Inter, Arial, sans-serif; font-size: 12px; color: #d1fae5;">Confirmaci&oacute;n de Pago</td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- HERO -->
                    <tr>
                        <td style="padding: 40px 32px 24px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="padding-bottom: 16px;">
                                        <table cellpadding="0" cellspacing="0" border="0" style="width: 64px; height: 64px; border-radius: 50%; background-color: #F0FDF4;">
                                            <tr>
                                                <td align="center" style="font-size: 28px; line-height: 64px; color: #10B981;">✓</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="font-family: Manrope, Arial, sans-serif; font-size: 26px; font-weight: 700; color: #10B981; letter-spacing: -0.5px; padding-bottom: 12px;">
                                        {{#if isLandlord}}&iexcl;Pago recibido!{{else}}&iexcl;Pago confirmado!{{/if}}
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="font-family: Inter, Arial, sans-serif; font-size: 16px; color: #536379; line-height: 1.6;">
                                        Hola {{nombre}} {{apellido}},
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="font-family: Inter, Arial, sans-serif; font-size: 14px; color: #777587; line-height: 1.5; padding-top: 4px;">
                                        {{#if isLandlord}}Tu inquilino ha realizado un pago exitosamente.{{else}}Tu pago ha sido procesado exitosamente. A continuaci&oacute;n encontrar&aacute;s el resumen detallado de tu transacci&oacute;n en la plataforma RentUp.{{/if}}
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- PAYMENT DETAILS -->
                    <tr>
                        <td style="padding: 8px 32px 24px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 12px;">
                                <tr>
                                    <td style="padding: 24px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td colspan="2" style="padding-bottom: 12px; font-family: Manrope, Arial, sans-serif; font-size: 12px; font-weight: 700; color: #1c2d44; text-transform: uppercase; letter-spacing: 0.5px;">Detalles del Pago</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; width: 40%;">Monto</td>
                                                <td style="padding: 8px 0; font-family: Manrope, Arial, sans-serif; font-size: 18px; font-weight: 700; color: #10B981; text-align: right;">${{formatCurrency amount}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; border-top: 1px solid #BBF7D0;">Vivienda</td>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 600; color: #1c2d44; text-align: right; border-top: 1px solid #BBF7D0;">{{direccion}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; border-top: 1px solid #BBF7D0;">Recibo N&deg;</td>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 600; color: #1c2d44; text-align: right; border-top: 1px solid #BBF7D0;">{{paymentId}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; border-top: 1px solid #BBF7D0;">Fecha</td>
                                                <td style="padding: 8px 0; font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 600; color: #1c2d44; text-align: right; border-top: 1px solid #BBF7D0;">{{todayDate}}</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    {{#if receiptUrl}}
                    <!-- CTA -->
                    <tr>
                        <td align="center" style="padding: 8px 32px 32px;">
                            <!--[if mso]>
                            <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{receiptUrl}}" style="height:48px;v-text-anchor:middle;width:220px;" arcsize="50%" fillcolor="#10B981">
                                <w:anchorlock/>
                                <center style="color:#ffffff;font-family:Manrope, Arial, sans-serif;font-size:14px;font-weight:600;">Descargar Recibo PDF</center>
                            </v:roundrect>
                            <![endif]-->
                            <!--[if !mso]><!-->
                            <a href="{{receiptUrl}}" style="display: inline-block; background-color: #10B981; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 999px; font-family: Manrope, Arial, sans-serif; font-size: 14px; font-weight: 600; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);">Descargar Recibo PDF</a>
                            <!--<![endif]-->
                        </td>
                    </tr>
                    {{/if}}

                    <tr>
                        <td align="center" style="padding: 0 32px 32px; font-family: Inter, Arial, sans-serif; font-size: 12px; color: #777587; line-height: 1.5;">
                            Este es un comprobante autom&aacute;tico de transacci&oacute;n. Si tienes dudas sobre este cobro, por favor contacta a nuestro equipo de soporte.
                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td style="padding: 0 32px 32px;">
                            {{> _footer}}
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
