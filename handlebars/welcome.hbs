<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>Bienvenido a RentUp</title>
    <style>
        body { margin: 0; padding: 0; background-color: #f7f9fb; font-family: Inter, Arial, sans-serif; }
        table { border-spacing: 0; }
        @media only screen and (max-width: 620px) {
            .container { width: 100% !important; max-width: 100% !important; }
            .content { padding: 20px 16px !important; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f7f9fb;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f7f9fb">
        <tr>
            <td align="center" style="padding: 40px 16px;">
                <table width="600" cellpadding="0" cellspacing="0" border="0" class="container" style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 3px rgba(14,26,43,0.04), 0 8px 24px -12px rgba(14,26,43,0.12);">

                    <!-- HEADER -->
                    <tr>
                        <td bgcolor="#faf8f3" style="padding: 20px 32px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="font-family: Manrope, Arial, sans-serif; font-size: 20px; font-weight: 700; color: #2E5A88;"><img src="data:image/png;base64," alt="RentUp" style="display:block;height:28px;width:auto;border:0;outline:none;" /></td>
                                    <td align="right" style="font-family: Inter, Arial, sans-serif; font-size: 12px; color: #777587;">Tu plataforma de confianza</td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- HERO -->
                    <tr>
                        <td style="padding: 40px 32px 24px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="font-family: Manrope, Arial, sans-serif; font-size: 28px; font-weight: 700; color: #2E5A88; letter-spacing: -0.5px; padding-bottom: 8px;">
                                        &iexcl;Bienvenido a RentUp, {{nombre}} {{apellido}}!
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="font-family: Inter, Arial, sans-serif; font-size: 16px; color: #536379; line-height: 1.6; padding-bottom: 24px;">
                                        Tu cuenta ha sido creada exitosamente. Estamos listos para ayudarte a encontrar tu pr&oacute;ximo hogar estudiantil.
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 8px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-radius: 16px; overflow: hidden;">
                                            <tr>
                                                <td style="background-color: #d8e4f0; height: 180px; text-align: center; vertical-align: middle; font-family: Inter, Arial, sans-serif; font-size: 14px; color: #2E5A88;">
                                                    [Imagen de vivienda estudiantil]
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- FEATURES -->
                    <tr>
                        <td style="padding: 8px 32px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="padding-bottom: 16px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #ffffff; border: 1px solid #e5dfd2; border-radius: 12px;">
                                            <tr>
                                                <td width="60" style="padding: 20px 16px 20px 20px; vertical-align: top;">
                                                    <table cellpadding="0" cellspacing="0" border="0" style="width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, #EEF3F9, #D8E4F0);">
                                                        <tr>
                                                            <td align="center" style="font-size: 20px; line-height: 44px;">🏠</td>
                                                        </tr>
                                                    </table>
                                                </td>
                                                <td style="padding: 20px 20px 20px 0; vertical-align: middle;">
                                                    <div style="font-family: Manrope, Arial, sans-serif; font-size: 14px; font-weight: 600; color: #2E5A88; padding-bottom: 4px;">Encuentra tu vivienda</div>
                                                    <div style="font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; line-height: 1.5;">Miles de opciones verificadas cerca de la universidad con filtros especializados.</div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding-bottom: 16px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #ffffff; border: 1px solid #e5dfd2; border-radius: 12px;">
                                            <tr>
                                                <td width="60" style="padding: 20px 16px 20px 20px; vertical-align: top;">
                                                    <table cellpadding="0" cellspacing="0" border="0" style="width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, #EEF3F9, #D8E4F0);">
                                                        <tr>
                                                            <td align="center" style="font-size: 20px; line-height: 44px;">💬</td>
                                                        </tr>
                                                    </table>
                                                </td>
                                                <td style="padding: 20px 20px 20px 0; vertical-align: middle;">
                                                    <div style="font-family: Manrope, Arial, sans-serif; font-size: 14px; font-weight: 600; color: #2E5A88; padding-bottom: 4px;">Conecta directo</div>
                                                    <div style="font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; line-height: 1.5;">Comunicaci&oacute;n segura y directa con arrendadores evaluados por la comunidad.</div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding-bottom: 8px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #ffffff; border: 1px solid #e5dfd2; border-radius: 12px;">
                                            <tr>
                                                <td width="60" style="padding: 20px 16px 20px 20px; vertical-align: top;">
                                                    <table cellpadding="0" cellspacing="0" border="0" style="width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, #EEF3F9, #D8E4F0);">
                                                        <tr>
                                                            <td align="center" style="font-size: 20px; line-height: 44px;">📄</td>
                                                        </tr>
                                                    </table>
                                                </td>
                                                <td style="padding: 20px 20px 20px 0; vertical-align: middle;">
                                                    <div style="font-family: Manrope, Arial, sans-serif; font-size: 14px; font-weight: 600; color: #2E5A88; padding-bottom: 4px;">Gestiona contratos</div>
                                                    <div style="font-family: Inter, Arial, sans-serif; font-size: 13px; color: #777587; line-height: 1.5;">Todo el papeleo legal digital, firmas seguras y documentos organizados.</div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- CTA -->
                    <tr>
                        <td align="center" style="padding: 32px 32px 40px;">
                            <!--[if mso]>
                            <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{frontendUrl}}/dashboard" style="height:48px;v-text-anchor:middle;width:220px;" arcsize="50%" fillcolor="#5849e4">
                                <w:anchorlock/>
                                <center style="color:#ffffff;font-family:Manrope, Arial, sans-serif;font-size:14px;font-weight:600;">Comenzar ahora →</center>
                            </v:roundrect>
                            <![endif]-->
                            <!--[if !mso]><!-->
                            <a href="{{frontendUrl}}/dashboard" style="display: inline-block; background: linear-gradient(135deg, #3f2acc, #5849e4); color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 999px; font-family: Manrope, Arial, sans-serif; font-size: 14px; font-weight: 600; box-shadow: 0 4px 12px rgba(63, 42, 204, 0.25);">Comenzar ahora →</a>
                            <!--<![endif]-->
                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td style="padding: 0 32px 32px;">
                            {{> _footer}}
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>