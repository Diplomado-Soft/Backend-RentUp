<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><meta name="color-scheme" content="light"><meta name="supported-color-schemes" content="light"><title>Reporte de Mantenimiento - RentUp</title></head>
<body style="margin:0;padding:0;background-color:#f3f4f6;font-family:Inter,Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f3f4f6;"><tr><td align="center" style="padding:24px 16px;">
<table role="presentation" width="100%" style="max-width:600px;" cellpadding="0" cellspacing="0" border="0" class="container">
<tr><td bgcolor="#F59E0B" style="padding:20px 32px;">
<table width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
<td style="font-family:Inter,Arial,sans-serif;font-size:20px;font-weight:700;color:#ffffff;"><img src="data:image/png;base64,...</span></td>
<td align="right" style="font-family:Inter,Arial,sans-serif;font-size:12px;color:#FDE68A;">Reporte de Mantenimiento</td>
</tr></table>
</td></tr>
<tr><td style="padding:40px 32px 24px;">
<table width="100%" cellpadding="0" cellspacing="0" border="0">
<tr><td align="center" style="padding-bottom:16px;">
<table cellpadding="0" cellspacing="0" border="0" style="width:80px;height:80px;border-radius:50%;background-color:#FFFBEB;"><tr><td align="center" style="font-size:36px;line-height:80px;">&#128295;</td></tr></table>
</td></tr>
<tr><td align="center" style="font-size:24px;font-weight:700;color:#D97706;padding-bottom:8px;">Nuevo reporte de mantenimiento</td></tr>
<tr><td align="center" style="font-size:15px;color:#6B7280;line-height:1.6;">Hola {{nombre}}, un inquilino ha reportado un problema en una de tus propiedades.</td></tr>
</table>
</td></tr>
<tr><td style="padding:8px 32px 24px;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#FFFBEB;border:1px solid #FDE68A;border-radius:12px;"><tr><td style="padding:24px;">
<table width="100%" cellpadding="0" cellspacing="0" border="0">
<tr><td style="padding:8px 0;font-size:13px;color:#6B7280;width:30%;">T&iacute;tulo</td><td style="padding:8px 0;font-size:14px;font-weight:600;color:#1F2937;text-align:right;">{{report.title}}</td></tr>
<tr><td style="padding:8px 0;font-size:13px;color:#6B7280;border-top:1px solid #FDE68A;">Descripci&oacute;n</td><td style="padding:8px 0;font-size:14px;color:#1F2937;text-align:right;border-top:1px solid #FDE68A;">{{#if report.description}}{{report.description}}{{else}}Sin descripci&oacute;n{{/if}}</td></tr>
<tr><td style="padding:8px 0;font-size:13px;color:#6B7280;border-top:1px solid #FDE68A;">Prioridad</td><td style="padding:8px 0;text-align:right;border-top:1px solid #FDE68A;"><span style="display:inline-block;padding:4px 12px;border-radius:999px;font-size:12px;font-weight:600;{{#if (eq report.priority 'urgent')}}background-color:#FEF2F2;color:#DC2626;{{else if (eq report.priority 'high')}}background-color:#FFFBEB;color:#D97706;{{else if (eq report.priority 'medium')}}background-color:#FEFCE8;color:#CA8A04;{{else}}background-color:#F0FDF4;color:#16A34A;{{/if}}">{{priorityLabel report.priority}}</span></td></tr>
<tr><td style="padding:8px 0;font-size:13px;color:#6B7280;border-top:1px solid #FDE68A;">Fecha</td><td style="padding:8px 0;font-size:14px;font-weight:600;color:#1F2937;text-align:right;border-top:1px solid #FDE68A;">{{report.created_at}}</td></tr>
</table>
</td></tr></table>
</td></tr>
<tr><td style="padding:0 32px 24px;"><p style="margin:0;font-size:14px;color:#6B7280;text-align:center;">Ingresa a tu panel para gestionar este reporte.</p></td></tr>
<tr><td align="center" style="padding:8px 32px 40px;">
