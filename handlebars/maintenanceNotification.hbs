<v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{frontendUrl}}/dashboard" style="height:48px;v-text-anchor:middle;width:200px;" arcsize="50%" fillcolor="#3f2acc">
<w:anchorlock/>
<center style="color:#ffffff;font-family:Inter,Arial,sans-serif;font-size:14px;font-weight:600;">Gestionar reporte</center>
</v:roundrect>
<![endif]-->
